{
  "name": "SGT Hydroedge — Send Email (Gmail API)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sgt-send-email",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "6b1f2c1e-0d5a-4f7e-9b1a-1a2b3c4d5e01",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "sgt-send-email"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.body.to }}",
        "subject": "={{ $json.body.subject }}",
        "emailType": "html",
        "message": "={{ $json.body.html }}",
        "options": {
          "appendAttribution": false,
          "ccList": "={{ $json.body.cc }}",
          "senderName": "={{ $json.body.fromName }}"
        }
      },
      "id": "6b1f2c1e-0d5a-4f7e-9b1a-1a2b3c4d5e03",
      "name": "Send a message",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [260, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Send a message", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
