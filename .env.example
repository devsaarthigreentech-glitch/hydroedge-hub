# ============================================================================
# ENVIRONMENT VARIABLES - SGT Hydroedge Admin Panel
# Copy this file to .env.local and fill in your values
# ============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gps_tracking
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ----------------------------------------------------------------------------
# Alert emails (POST /api/alerts/check)
# ----------------------------------------------------------------------------
# Without GMAIL_USER and GMAIL_APP_PASSWORD the scan still runs and still logs,
# but every send returns "not configured" and no mail leaves the box.
# GMAIL_APP_PASSWORD is a Google App Password, not the account password.
GMAIL_USER=alerts@yourdomain.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM=alerts@yourdomain.com

# Always CC'd on every customer alert. Comma-separated.
SUPPORT_EMAILS=ajinkya@sgthydroedge.com,mangesh@sgthydroedge.com

# Optional: Production settings
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=https://your-domain.com/api
