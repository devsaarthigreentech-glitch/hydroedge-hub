# ============================================================================
# ENVIRONMENT VARIABLES - SGT Hydroedge Admin Panel
# Copy this file to .env.local and fill in your values
# ============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gps_tracking
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ----------------------------------------------------------------------------
# Alert emails (POST /api/alerts/check)
# ----------------------------------------------------------------------------
# Without GMAIL_USER and GMAIL_APP_PASSWORD the scan still runs and still logs,
# but every send returns "not configured" and no mail leaves the box.
# GMAIL_APP_PASSWORD is a Google App Password, not the account password.
GMAIL_USER=alerts@yourdomain.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM=alerts@yourdomain.com

# Always CC'd on every customer alert. Comma-separated.
SUPPORT_EMAILS=ajinkya@sgthydroedge.com,mangesh@sgthydroedge.com

# Optional: Production settings
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=https://your-domain.com/api

# ----------------------------------------------------------------------------
# Archive database (optional) — raw io_records history on a second Postgres
# ----------------------------------------------------------------------------
# Only /api/io-logs uses this, and only for devices listed below on windows
# older than the cutover. Leave ARCHIVE_DB_HOST unset and nothing changes.
#
# All three of HOST, CUTOVER and DEVICE_IDS must be set or routing stays off.
ARCHIVE_DB_HOST=145.223.19.24
ARCHIVE_DB_PORT=5432
ARCHIVE_DB_NAME=sgt_hydroedge_archive
ARCHIVE_DB_USER=sgt_admin
ARCHIVE_DB_PASSWORD=your_archive_password
# TLS for the cross-host hop. Encrypts but does not verify the cert chain.
ARCHIVE_DB_SSL=true

# Rows strictly BEFORE this instant come from the archive; at/after, from prod.
ARCHIVE_CUTOVER_UTC=2026-03-24T00:00:00+05:30

# Only these devices are ever routed to the archive.
#   SGT-GD-0226-0015, SGT-GD-0226-0016
ARCHIVE_DEVICE_IDS=53f93b3a-aa30-4d2a-92d8-9a0def238f47,55f6f637-5bc5-4d9b-8118-0083ff4528c5
