# ============================================================================
# ENVIRONMENT VARIABLES - SGT Hydroedge Admin Panel
# Copy this file to .env.local and fill in your values
# ============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gps_tracking
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ----------------------------------------------------------------------------
# Alert emails (POST /api/alerts/check)
# ----------------------------------------------------------------------------
# Without GMAIL_USER and GMAIL_APP_PASSWORD the scan still runs and still logs,
# but every send returns "not configured" and no mail leaves the box.
# GMAIL_APP_PASSWORD is a Google App Password, not the account password.
GMAIL_USER=alerts@yourdomain.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_FROM=alerts@yourdomain.com

# ----------------------------------------------------------------------------
# n8n → Gmail API (preferred on the droplet)
# ----------------------------------------------------------------------------
# DigitalOcean blocks outbound SMTP. When N8N_EMAIL_WEBHOOK_URL is set, every
# email is built here and POSTed to n8n, which sends it through the Gmail API
# over HTTPS. Import n8n/send-email-workflow.json. The secret must match the
# value of the n8n Header Auth credential (header name X-Webhook-Secret).
# GMAIL_FROM above is still used as the From address. GMAIL_USER and
# GMAIL_APP_PASSWORD are not needed on this path.
N8N_EMAIL_WEBHOOK_URL=https://n8n.saarthigreen.com/webhook/sgt-send-email
N8N_EMAIL_WEBHOOK_SECRET=long_random_string

# ----------------------------------------------------------------------------
# SMTP relay
# ----------------------------------------------------------------------------
# This host's provider blocks outbound 25 / 465 / 587 (every relay times out at
# the TCP level); port 2525 is open. Set these to use a relay that offers 2525.
# Leave them unset to fall back to the GMAIL_* values on 587.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your_relay_login
SMTP_PASS=your_relay_smtp_key
SMTP_FROM=notifications@yourdomain.com

# Always CC'd on every customer alert. Comma-separated.
SUPPORT_EMAILS=ajinkya@sgthydroedge.com,mangesh@sgthydroedge.com

# Optional: Production settings
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=https://your-domain.com/api

# ----------------------------------------------------------------------------
# History store (optional) — io_records older than prod, read from Spaces
# ----------------------------------------------------------------------------
# Logs & Messages (and its CSV export) read windows before the cutover from
# history/ in the Spaces bucket (written by scripts/split-history.sh).
# Leave the key unset and every window is served from prod alone.
HISTORY_S3_KEY=your_read_only_spaces_key
HISTORY_S3_SECRET=your_read_only_spaces_secret
# HISTORY_S3_BUCKET=sgt-hydroedge-archive
# HISTORY_S3_REGION=sgp1
# Prod io_records starts here; earlier rows come from the history store.
# HISTORY_CUTOVER_UTC=2026-09-07T00:00:00Z
